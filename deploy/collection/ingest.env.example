# Public container IDs accepted by this endpoint (space-separated in the unit).
PYTAGMANAGER_CONTAINERS=GTM-ABC1234

# Public same-domain collection path.
PYTAGMANAGER_PATH=/collect

# Optional: forward validated events to PyTagShield.
PYTAGSHIELD_URL=https://shield.internal.example
PYTAGSHIELD_TOKEN_REF=env:PYTAGSHIELD_INGEST_TOKEN
PYTAGSHIELD_TOKEN=replace-me

# Abuse limits. Tune for expected traffic.
PYTAGMANAGER_RATE_LIMIT=600
PYTAGMANAGER_MAX_BODY=65536
PYTAGMANAGER_MAX_BATCH=100
PYTAGMANAGER_DEDUPE_TTL=86400
PYTAGMANAGER_DEDUPE_CLAIM_TTL=60
PYTAGMANAGER_DEDUPE_DB=/var/lib/pytagmanager/dedupe.sqlite3

# CORS origin(s). Use the exact production origin, not * where possible.
PYTAGMANAGER_ORIGIN=https://www.example.com
