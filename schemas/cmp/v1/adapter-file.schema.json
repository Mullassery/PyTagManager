{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pytagmanager.dev/schemas/cmp/v1/adapter-file.schema.json",
  "title": "PyTagManager declarative CMP adapter file v1",
  "description": "Data-only adapter declarations. Adapter files are never imported as Python or executed as JavaScript.",
  "type": "object",
  "required": ["schema_version", "adapters"],
  "properties": {
    "schema_version": {"const": 1},
    "adapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["adapter_id", "vendor"],
        "properties": {
          "adapter_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "vendor": {"type": "string", "minLength": 1, "maxLength": 200},
          "contract_version": {"type": "string", "minLength": 1},
          "script_markers": {"$ref": "#/$defs/stringArray"},
          "url_markers": {"$ref": "#/$defs/stringArray"},
          "markup_markers": {"$ref": "#/$defs/stringArray"},
          "global_names": {"$ref": "#/$defs/stringArray"},
          "cookie_names": {"$ref": "#/$defs/stringArray"},
          "cookie_prefixes": {"$ref": "#/$defs/stringArray"},
          "accept_selectors": {"$ref": "#/$defs/stringArray"},
          "reject_selectors": {"$ref": "#/$defs/stringArray"},
          "notes": {"$ref": "#/$defs/stringArray"}
        },
        "additionalProperties": false,
        "anyOf": [
          {"required": ["script_markers"]},
          {"required": ["url_markers"]},
          {"required": ["markup_markers"]},
          {"required": ["global_names"]},
          {"required": ["cookie_names"]},
          {"required": ["cookie_prefixes"]}
        ]
      }
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  },
  "additionalProperties": false
}
