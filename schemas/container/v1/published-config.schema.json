{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pytagmanager.dev/schemas/container/v1/published-config.schema.json",
  "title": "PyTagManager Published Container Configuration v1",
  "description": "Public, secret-free configuration distributed through a CDN and consumed by client SDKs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "container_id",
    "config_version",
    "revision_number",
    "environment",
    "published_at",
    "event_schema_version",
    "events",
    "tags",
    "destinations",
    "features",
    "compatibility",
    "cache",
    "integrity"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "kind": {"const": "pytagmanager.container"},
    "container_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "config_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "revision_number": {"type": "integer", "minimum": 1},
    "revision_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "protected"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "protected": {"type": "boolean"}
      }
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
    },
    "event_schema_version": {"const": "1.0"},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "purposes", "tag_ids"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"},
          "purposes": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}
          },
          "tag_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "format": "uuid"}
          }
        }
      }
    },
    "consent_defaults": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,63}$"},
      "additionalProperties": {"type": "boolean"}
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag_id", "name", "type", "enabled", "trigger_ids", "destination_ids"],
        "properties": {
          "tag_id": {"type": "string", "format": "uuid"},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "type": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
          "event_name": {"type": ["string", "null"]},
          "consent_purpose": {"type": ["string", "null"]},
          "enabled": {"type": "boolean"},
          "trigger_ids": {
            "type": "array",
            "items": {"type": "string", "format": "uuid"}
          },
          "destination_ids": {
            "type": "array",
            "items": {"type": "string", "format": "uuid"}
          }
        }
      }
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["destination_id", "name", "kind", "enabled"],
        "properties": {
          "destination_id": {"type": "string", "format": "uuid"},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "enabled": {"type": "boolean"}
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_side_execution", "event_collection", "server_side_forwarding"],
      "properties": {
        "client_side_execution": {"const": false},
        "event_collection": {"const": true},
        "server_side_forwarding": {"const": true}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_contract", "min_sdk"],
      "properties": {
        "event_contract": {"const": "1.0"},
        "min_sdk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["web", "android", "ios"],
          "properties": {
            "web": {"type": "string"},
            "android": {"type": "string"},
            "ios": {"type": "string"}
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_age_seconds", "immutable"],
      "properties": {
        "max_age_seconds": {"type": "integer", "minimum": 0},
        "immutable": {"type": "boolean"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
