{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pytagmanager.dev/schemas/events/v1/batch.schema.json",
  "title": "PyTagManager Event Batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "event.schema.json"}
    }
  }
}
