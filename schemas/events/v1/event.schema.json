{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pytagmanager.dev/schemas/events/v1/event.schema.json",
  "title": "PyTagManager Event v1",
  "description": "Canonical client-to-server event contract shared by the Web, Android, and iOS SDKs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_name",
    "timestamp",
    "source",
    "container_id",
    "properties"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "description": "Stable UUID used for deduplication. SDKs generate a new UUIDv4 for each logical event."
    },
    "event_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,79}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$",
      "description": "RFC 3339 UTC timestamp. Servers may reject events outside the configured clock-skew window."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "sdk_name", "sdk_version"],
      "properties": {
        "platform": {
          "enum": ["web", "android", "ios", "server"]
        },
        "sdk_name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "sdk_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "app_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,63}$"
        }
      }
    },
    "container_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "config_version": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "description": "Pseudonymous subject identifier. Do not use email addresses, phone numbers, or device advertising IDs."
        },
        "type": {
          "enum": ["user", "anonymous"]
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purposes", "source", "provenance"],
      "properties": {
        "purposes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "source": {
          "enum": ["sdk", "host", "server", "unknown"]
        },
        "provenance": {
          "enum": ["explicit", "default", "stored", "unknown"]
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "correlation_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "session_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    },
    "properties": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/propertyValue"
      }
    }
  },
  "$defs": {
    "scalar": {
      "anyOf": [
        {"type": "string", "maxLength": 2048},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"}
      ]
    },
    "propertyValue": {
      "anyOf": [
        {"$ref": "#/$defs/scalar"},
        {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/propertyValue"}
        },
        {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"},
          "additionalProperties": {"$ref": "#/$defs/propertyValue"}
        }
      ]
    }
  }
}
