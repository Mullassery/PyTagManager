{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pytagmanager.local/schemas/sdr/v1/sdr.schema.json",
  "title": "PyTagManager Solution Design Reference v1",
  "description": "An SDR document used to validate observed dataLayer events and parameters. CSV input uses the equivalent event_name/parameter_name columns.",
  "type": "object",
  "required": ["schema_version", "events"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "$defs": {
    "typeName": {
      "type": "string",
      "enum": ["any", "string", "number", "integer", "boolean", "array", "object"]
    },
    "event": {
      "type": "object",
      "required": ["event_name"],
      "additionalProperties": false,
      "properties": {
        "event_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "page_contains": {"type": "string", "maxLength": 500},
        "selector": {"type": "string", "maxLength": 300},
        "require_network": {"type": "boolean", "default": false},
        "parameters": {
          "type": "array",
          "items": {"$ref": "#/$defs/parameter"}
        }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "type": {
          "oneOf": [
            {"$ref": "#/$defs/typeName"},
            {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/typeName"}}
          ]
        },
        "required": {"type": "boolean", "default": true},
        "allowed": {
          "type": "array",
          "items": {"type": ["string", "number", "boolean"]}
        },
        "description": {"type": "string"}
      }
    }
  }
}
